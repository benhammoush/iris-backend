{
  "name": "iris-backend",
  "version": "3.15.7",
  "description": "Iris market and curated-wallet API on Cloudflare Workers",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "lint": "eslint .",
    "check:tooling": "node scripts/check-tooling.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:dependencies": "npm audit && npm audit --omit=dev",
    "dev": "wrangler dev --local --env local --port 8787 --persist-to .wrangler/local",
    "dev:e2e": "wrangler dev --local --env e2e --port 8787 --persist-to .wrangler/e2e",
    "seed:e2e": "node --import tsx scripts/seed-e2e-kv.mjs",
    "e2e:serve": "npm run seed:e2e && npm run dev:e2e",
    "test": "node scripts/test.mjs",
    "check:types": "tsc --noEmit",
    "check:versions": "node scripts/check-version.mjs",
    "lint:openapi": "node scripts/lint-openapi.mjs openapi.yaml",
    "check": "wrangler deploy --dry-run --env production"
  },
  "license": "ISC",
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261012.1",
    "@eslint/js": "^10.0.1",
    "@redocly/openapi-core": "2.62.1",
    "@types/node": "^26.6.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "wrangler": "^4.149.0",
    "yaml": "^2.8.1"
  }
}
