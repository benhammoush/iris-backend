{
  "name": "iris-backend",
  "version": "3.16.0",
  "description": "Iris market and curated-wallet API on Cloudflare Workers",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "ci:quality": "npm run check",
    "ci:prepare": "node scripts/ci-prepare.mjs",
    "lint": "eslint .",
    "check:tooling": "node scripts/check-tooling.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:dependencies": "npm audit && npm audit --omit=dev",
    "dev": "wrangler dev --local --env local --port 8787 --persist-to .wrangler/local",
    "dev:e2e": "wrangler dev --local --env e2e --port 8787 --persist-to .wrangler/e2e",
    "seed:e2e": "node --import tsx scripts/seed-e2e-kv.mjs",
    "e2e:serve": "npm run seed:e2e && npm run dev:e2e",
    "test": "node scripts/test.mjs",
    "test:merge-policy": "node --test tests/tooling/merge-gate.test.mjs",
    "check:types": "tsc --noEmit",
    "check:versions": "node scripts/check-version.mjs",
    "lint:openapi": "node scripts/lint-openapi.mjs openapi.yaml",
    "build": "wrangler deploy --dry-run --env production",
    "check": "npm run lint && npm run format:check && npm run check:tooling && npm run audit:dependencies && npm run check:versions && npm run check:types && npm run lint:openapi && npm test && npm run test:merge-policy && npm run build"
  },
  "license": "ISC",
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261012.1",
    "@eslint/js": "^10.0.1",
    "@redocly/openapi-core": "2.62.1",
    "@types/node": "^26.6.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "miniflare": "5.20261006.1-alpha",
    "prettier": "^3.9.10",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "wrangler": "^4.149.0",
    "yaml": "^2.8.1"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1"
    }
  },
  "dependencies": {
    "jose": "6.2.13"
  }
}
