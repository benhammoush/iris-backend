# Browser origins allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Optional locally. Helius enables Solana RPC and decoded activity refreshes.
HELIUS_API_KEY=
# Optional locally. Jupiter enables token metadata and price refreshes.
JUPITER_API_KEY=
# Optional locally. Birdeye enables on-demand USD OHLCV history.
BIRDEYE_API_KEY=
